# Database (SQLite file in the project folder)
DATABASE_URL="file:./dev.db"

# Where uploaded client documents are stored on the server (keep this folder backed up!)
ARCHIVE_STORAGE_DIR="./storage"

# Optional: turns on the AI sorting agent (Claude). Without it, a keyword-based sorter is used.
ANTHROPIC_API_KEY=""

# Optional: password for staff pages. Leave empty only for local demos.
ADMIN_PASSWORD=""

# Public address of the site, used in share links and QR codes on printed tags
PUBLIC_BASE_URL="http://localhost:3000"
